# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Company Search Providers
# =============================================================================

# Hunter API (for B2B company discovery)
HUNTER_API_KEY=your-hunter-api-key

# Google Places API (for local business discovery)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =============================================================================
# Agent Settings
# =============================================================================

# Maximum companies to process per run
AGENT_MAX_CANDIDATES=10
AGENT_MAX_RESEARCH=5
CONTACT_MAX_PEOPLE=3

# =============================================================================
# Research Settings
# =============================================================================

# Maximum pages to crawl per company
RESEARCH_MAX_PAGES=4

# Maximum evidence items to collect
RESEARCH_MAX_EVIDENCE=8

# Trusted Laravel callback origin (Docker host gateway).
LARAVEL_CALLBACK_BASE_URL=http://host.docker.internal:8092
